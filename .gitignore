# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environment
venv/
env/
.env
.venv*/

# Ignore all models artifacts by default; re-allow selected small JSONs below
models/**

# Ignore large/binary model artifacts by type
*.pkl
*.joblib
*.pt
*.onnx
*.safetensors
models/**/model.safetensors
models/**/pytorch_model.bin
models/**/pytorch_model.bin.index.json
models/**/optimizer.pt
models/**/scheduler.pt
models/transformers/**/tokenizer/**

!models/**/model_metadata.json
!models/**/metrics.json
!models/**/holdout_metrics.json
!models/**/classifier_config.json
!models/**/calibration_metrics.json
!models/**/manifest.json
!models/**/label_map.json
!models/registry/*.json
!models/specs/*.json

# Ignore runtime cache (downloaded weights/tokenizers)
runtime_cache/

# Hugging Face cache
cache/
**/.cache/
**/.huggingface/

# Ignore raw/enriched data CSVs except explicit small examples
data/*.csv
!data/sample_tickets.csv
!data/generate_dataset.py

# Ignore logs
*.log

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore pytest cache
.pytest_cache/

# Ignore coverage reports
htmlcov/
.coverage

# Ignore temporary files
/tmp/
*.tmp